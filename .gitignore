# 虚拟环境
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# PyInstaller 打包产物（ncmctl-gui.spec 生成）
build/
dist/

# 由 scripts/fetch_ncmctl.py 下载来的 ncmctl 本体（约 20 MB，不入库）。
# 版本与校验和钉在那个脚本里，要换版本改脚本，别把二进制提上来。
vendor/

# 最近一次打 tag 时 workflow 的临时目录
squashfs-root/
AppDir/

# 编辑器
.vscode/
.idea/
*.swp

# 本程序运行时不会在本目录写东西（配置在 ~/.config/ncmctl-gui/），
# 但下面这些是调试时可能出现的手工产物
*.log
/tmp-shots/
