# 功能迁移时参考的 SPlayer-Next 克隆。只读参考，绝不入库、绝不推送；
# 迁移完成后删除（见 README「许可」）。
/SPlayer-Next/

# 虚拟环境
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# PyInstaller 打包产物（ncm-studio.spec 生成）
build/
dist/

# 由 scripts/fetch_ncmctl.py 下载来的 ncmctl 本体（约 20 MB，不入库）。
# 版本与校验和钉在那个脚本里，要换版本改脚本，别把二进制提上来。
vendor/

# 最近一次打 tag 时 workflow 的临时目录
squashfs-root/
AppDir/

# 发布签名私钥（只应存在于 ~/.config/ncm-studio-release/，绝不入库）
signing-key*.pem
*.release-key

# 编辑器
.vscode/
.idea/
*.swp

# 本程序运行时不会在本目录写东西（配置在 ~/.config/ncm-studio/），
# 但下面这些是调试时可能出现的手工产物
*.log
/tmp-shots/

# 本地推广视频脚本：依赖本机字体、录屏素材与 ffmpeg/NVENC，
# 只用于制作演示视频，不入库、不参与打包
/promo_build.py
/promo_cover.py
/promo_cover_34.py
/promo_record.py
